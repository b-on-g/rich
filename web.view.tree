$mol_icon_arrow_down $mol_icon path \M11,4H13V16L18.5,10.5L19.92,11.92L12,19.84L4.08,11.92L5.5,10.5L11,16V4Z

$mol_button_major $mol_button_minor
	theme \$mol_theme_base

$mol_status $mol_view
	status <= title
	minimal_height 24
	minimal_width 0
	sub /
		<= message \

$mol_form $mol_list
	submit_allowed true
	submit_blocked false
	event *
		^
		keydown? <=> keydown? null
	save? null
	message_done @ \Saved
	errors *string
		\Form invalid
			<= form_invalid @ \Form is not valid
	rows /
		<= Body $mol_list
			sub <= body <= form_fields /$mol_form_field
		<= Foot $mol_row
			sub <= foot <= buttons /$mol_view
				<= Submit $mol_button_major
					title <= submit_title @ \Save
					hint <= submit_hint \
					activate? => submit_activate?
					click? <=> submit? null
				<= Result $mol_status
					message <= result? null

$bog_rich_edit $mol_view
	content? null
	enabled true
	length_max +Infinity
	submit? null
	submit_with_enter false
	paste_files? null
	sub /
		<= Hint $mol_view
			sub /
				<= hint \
		<= Content $mol_view
			attr *
				^
				contenteditable <= editable \true
				role \textbox
				aria-multiline \true
				aria-label <= hint
			event *
				beforeinput? <=> before? null
				input? <=> typed? null
				compositionstart? <=> compose_start? null
				compositionend? <=> compose_end? null
				copy? <=> copy? null
				cut? <=> cut? null
				paste? <=> paste? null
				contextmenu? <=> context? null
			sub_visible <= drawn null
			plugins /
				<= Hotkey $bog_rich_hotkey
					action <= hotkeys *
		<= Menu $bog_rich_menu
			showed? <=> menu_showed? false
			spot? <=> menu_spot? null
			list <= menu_list true
			trigger_click? <=> menu_toggle? null
			escape? <=> menu_close? null
			bubble_content <= menu_content /$mol_view
	Commands $mol_list
		rows <= command_items /$mol_view
		plugins /
			<= Nav $mol_nav
				keys_y <= command_items
				current_y? <=> command_focused? null
				cycle? <=> command_cycle? true
	Command* $mol_button_minor
		enabled <= command_enabled* true
		click? <=> command_click*? null
		attr *
			^
			role \menuitemcheckbox
			aria-checked <= command_checked* \false
			bog_rich_edit_state <= command_state* \off
			bog_rich_edit_split <= command_split* false
		sub /
			<= Command_icon* $mol_view
				sub <= command_icon* /$mol_view
			<= Command_label* $mol_view
				sub /
					<= command_label* \
			<= Command_key* $mol_view
				sub /
					<= command_key* \
	Icon_bold $mol_icon_format_bold
	Icon_italic $mol_icon_format_italic
	Icon_underline $mol_icon_format_underline
	Icon_strikethrough $mol_icon_format_strikethrough
	Icon_blockquote $mol_icon_format_quote_close
	Icon_code $mol_icon_code_tags
	Icon_pre $mol_icon_code_braces
	Icon_spoiler $mol_icon_eye_off
	Icon_text_link $mol_icon_link
	Icon_date_time $mol_icon_calendar_clock
	Icon_clear $mol_icon_format_clear
	Icon_collapse $mol_icon_chevron_down
	Icon_leave $mol_icon_arrow_down
	labels *
		bold @ \Bold
		italic @ \Italic
		underline @ \Underline
		strikethrough @ \Strikethrough
		blockquote @ \Quote
		code @ \Monospace
		pre @ \Code
		spoiler @ \Spoiler
		text_link @ \Link
		date_time @ \Date
		clear @ \Clear formatting
		collapse @ \Collapsible quote
		leave @ \Exit block
	Link_form $mol_list
		rows /
			<= Link_text_field $mol_form_field
				name @ \Text
				control <= Link_text $mol_string
					value? <=> link_text? \
			<= Link_url_field $mol_form_field
				name @ \Address
				bids /
					<= link_bid \
				control <= Link_url $mol_string
					hint \https://
					keyboard \url
					value? <=> link_url? \
					submit? <=> link_apply? null
			<= Link_tools $mol_row
				sub <= link_tools /$mol_view
	link_wrong @ \Only web and mail addresses
	Link_apply $mol_button_major
		title @ \Apply
		enabled <= link_ready false
		click? <=> link_apply?
	Link_remove $mol_button_minor
		title @ \Remove link
		click? <=> link_remove? null
	Cancel $mol_button_minor
		title @ \Cancel
		click? <=> menu_close?
	Date_form $mol_list
		rows <= date_rows /$mol_view
	Date_moment_field $mol_form_field
		name @ \Date and time
		bids /
			<= date_bid \
		control <= Date_moment $mol_date
			value? <=> date_moment? \
	Date_zone_field $mol_form_field
		name @ \Time zone
		control <= Date_zone $mol_select
			options <= date_zones /string
			value? <=> date_zone? \
	Date_twin_field $mol_form_field
		name @ \This time happens twice
		control <= Date_twin $mol_switch
			value? <=> date_twin? \0
			options <= date_twins *
	Date_format_field $mol_form_field
		name @ \Format
		control <= Date_format $mol_select
			value? <=> date_format? \datetime
			dictionary <= date_formats *
	Date_text_field $mol_form_field
		name @ \Text
		control <= Date_text $mol_string
			value? <=> date_text? \
	Date_tools $mol_row
		sub <= date_tools /$mol_view
	Date_apply $mol_button_major
		title @ \Apply
		enabled <= date_ready false
		click? <=> date_apply? null
	Date_remove $mol_button_minor
		title @ \Remove date
		click? <=> date_remove? null
	date_wrong @ \Choose date and time
	date_missing @ \Clocks skip this time in the zone
	date_own @ \Custom text

$mol_icon_clipboard $mol_icon path \M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3

$mol_icon_clipboard_outline $mol_icon path \M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7Z

$mol_button_copy $mol_button_minor
	blobs /$mol_blob
		<= text_blob? $mol_blob /
			/BlobPart <= text <= title
			* type \text/plain
		<= html_blob? $mol_blob /
			/BlobPart <= html \
			* type \text/html
	data *
	sub /
		<= Icon $mol_icon_clipboard_outline
		<= title \

$mol_icon_download $mol_icon path \M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z

$mol_button_download $mol_button_minor
	blob null
	uri \
	file_name \blob.bin
	sub /
		<= Icon $mol_icon_download
		<= title \

$bog_rich_date $mol_pick
	text \
	timestamp 0
	format \datetime
	hint <= full \
	trigger_content /
		<= label \
	bubble_content /
		<= Full $mol_view
			sub /
				<= full
		<= Tools $mol_row
			sub /
				<= Copy $mol_button_copy
					hint @ \Copy date
					text <= full
					title @ \Copy
				<= Calendar $mol_button_download
					hint @ \Download calendar event
					file_name \event.ics
					blob <= ics $mol_blob
					title @ \To calendar

$mol_check_expand $mol_check
	Icon $mol_icon_chevron
	level 0
	style *
		^
		paddingLeft <= level_style \0px
	checked? <=> expanded? false
	enabled <= expandable false

$bog_rich_quote $mol_view
	dom_name \blockquote
	collapsed false
	long? false
	content /$mol_view_content
	attr *
		^
		bog_rich_quote_clamped <= clamped false
	sub /
		<= Text $mol_view
			sub <= content
		<= Toggle $mol_check_expand
			hint @ \Expand quote
			checked? <=> opened? false

$mol_stack $mol_view

$mol_text_code_token $mol_dimmer
	attr *
		^
		mol_text_code_token_type <= type \

$mol_text_code_token_link $mol_text_code_token
	dom_name \a
	type \code-link
	attr *
		^
		href <= uri \
		target \_blank

$mol_text_code_line $mol_paragraph
	text \
	minimal_height 24
	numb_showed true
	syntax null
	uri_resolve* \
	Numb $mol_view
		sub /
			<= numb 0
	Token* $mol_text_code_token
		type <= token_type* \
		haystack <= token_text* \
		needle <= highlight \
	Token_link* $mol_text_code_token_link
		haystack <= token_text* \
		needle <= highlight \
		uri <= token_uri* \
	find_pos* null

$mol_text_code $mol_stack
	attr *
		^
		mol_text_code_sidebar_showed <= sidebar_showed false
	text \
	text_lines /string
	find_pos* null
	uri_base \
	row_themes /string
	sub /
		<= Rows $mol_list
			render_visible_only <= render_visible_only false
			rows <= rows /
				<= Row*0 $mol_text_code_line
					numb_showed <= sidebar_showed
					numb <= row_numb* 0
					theme <= row_theme* \
					text <= row_text* \
					syntax <= syntax null
					uri_resolve* <= uri_resolve* \
					highlight <= highlight \
		<= Copy $mol_button_copy
			hint @ \Copy whole code
			text <= text_export \

$bog_rich_code $mol_text_code
	language \
	text_export <= text
	render_visible_only false
	Row* $bog_rich_code_line
		numb_showed false
		text <= row_text*
	sub /
		<= Head $mol_view
			sub /
				<= Language $mol_view
					sub /
						<= language
				<= Copy
		<= Rows

$bog_rich_code_line $mol_text_code_line

$mol_link $mol_view
	uri \
	dom_name \a
	uri_off \
	uri_native null
	external false
	attr *
		^
		href <= uri_unsafe <= uri_toggle \
		title <= hint_safe <= hint \
		target <= target \_self
		download <= file_name \
		mol_link_current <= current false
		rel <= relation \
	sub /$mol_view_content
		<= title
	arg *
	event *
		^
		click? <=> click? <=> event_click? null

$bog_rich_spoiler $mol_view
	dom_name \span
	shown? false
	mask \
	content /$mol_view_content
	hidden_label @ \Hidden text, press to reveal
	attr *
		^
		bog_rich_spoiler_shown <= shown
		role <= role \button
		tabindex <= tab \0
		aria-label <= label \
	event *
		^
		click? <=> reveal? null
		keydown? <=> press? null
	sub <= body /$mol_view_content

$bog_rich_render $mol_view
	content null
	auto_links true
	shown_text \
	shown_html \
	sub <= blocks /$mol_view
	Text* $mol_view
		sub <= block_content* /$mol_view_content
	Quote* $bog_rich_quote
		collapsed <= quote_collapsed* false
		content <= block_content*
	Code* $bog_rich_code
		text <= code_text* \
		language <= code_language* \
	Mark* $mol_view
		dom_name <= mark_tag* \span
		sub <= mark_content* /$mol_view_content
	Link* $mol_link
		uri <= link_uri* \
		hint <= link_uri*
		relation \noopener noreferrer
		sub <= mark_content*
	Auto* $mol_link
		uri <= auto_uri* \
		hint <= auto_uri*
		relation \noopener noreferrer
		sub /
			<= auto_uri*
	Spoiler* $bog_rich_spoiler
		mask <= spoiler_mask* \
		shown? <=> spoiler_shown*? false
		content <= mark_content*
	Date* $bog_rich_date
		text <= date_text* \
		timestamp <= date_timestamp* 0
		format <= date_format* \

$bog_rich_demo $mol_page
	title \$bog_rich
	plugins /
		<= Theme $mol_theme_auto
	tools /
		<= Lights $mol_lights_toggle
	body /
		<= Sample $mol_list
			rows /
				<= Edit $bog_rich_edit
					hint @ \Write something and select it…
					length_max 4096
					content? <=> content? null
				<= View_title $mol_paragraph
					title @ \How readers see it
				<= View $bog_rich_render
					content <= content?
				<= Model_title $mol_paragraph
					title @ \Model
				<= Model $mol_text_code
					text <= model_text \
				<= Other_title $mol_paragraph
					title @ \Independent editor, Enter submits
				<= Other $bog_rich_edit
					hint @ \Message…
					submit_with_enter true
					submit? <=> submit? null
					content? <=> other? null
				<= Sent $bog_rich_render
					content <= sent? null
